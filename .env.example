# Production environment for the course site. Copy to .env on the server (mode 600) and fill in.
# Values must be plain: letters, digits and simple punctuation, no quotes, no '#', no spaces.
# Comments go on their own line: systemd does not strip a '# ...' after a value, it becomes part of it.
# This file is read by systemd (EnvironmentFile) and by `set -a; . ./.env; set +a` before manage.py.
CALC_ENV=production
# python3 scripts/gen_secret_key.py   (letters and digits only)
SECRET_KEY=
ALLOWED_HOSTS=adderoaks.com
CSRF_TRUSTED_ORIGINS=https://adderoaks.com
FORCE_SCRIPT_NAME=/calc

DB_NAME=calc
DB_USER=calc
# python3 scripts/gen_secret_key.py too
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# the SMTP server of the email provider Adder picks
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@adderoaks.com
# comma-separated; gets teacher-account requests and server errors
ADMIN_EMAILS=
# shown on the privacy page
CONTACT_EMAIL=

# contact page: messages are saved, then emailed through Resend (resend.com). Empty key: saved only.
RESEND_API_KEY=
# where contact messages go
CONTACT_TO=
# sender, on a domain verified in Resend
CONTACT_FROM=contact@adderoaks.com

# production key from Desmos (the current one is a trial key)
DESMOS_API_KEY=
VIDEO_DIR=/home/deploy/calc-course/web/static/video
PDF_DIR=/home/deploy/calc-course/build/pdf
# true once the privacy and terms drafts are reviewed
LEGAL_PAGES_REVIEWED=false
BACKUP_DAYS=14
