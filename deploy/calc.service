# /etc/systemd/system/calc.service
[Unit]
Description=AP Calculus course (gunicorn, adderoaks.com/calc/)
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/calc-course/web
EnvironmentFile=/home/deploy/calc-course/.env
ExecStart=/home/deploy/calc-course/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8018 --workers 3 --timeout 60 \
    --access-logfile - --error-logfile -
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
